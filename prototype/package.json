{
  "name": "project-1900-prototypes",
  "private": true,
  "version": "0.1.0",
  "description": "First prototypes of the three top-ranked concepts for Project 1900: C07 The Departure Is the Turn, C01 Several Masters, One Truth, C04 The Legend Portfolio.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "imports": {
    "#kit/*": "./kit/src/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "data:validate": "node tools/validate/run.ts",
    "data:compile": "node tools/compile/compile-bundles.ts --all",
    "build": "node tools/make/bundle-game.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "golden:update": "node tools/make/golden-update.ts",
    "playtest:analyze": "node tools/playtest/analyze.ts",
    "check:static": "node tools/check/run-all.ts",
    "check": "npm run typecheck && npm run check:static && npm test && npm run build && npm run e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
